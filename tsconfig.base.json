{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@aetherfall/shared": ["./shared/src"],
      "@aetherfall/shared/dist/protocol2.js": ["./shared/dist/protocol2.d.ts", "./shared/src/protocol2.ts"],
      "@aetherfall/engine": ["./engine/src"]
    }
  }
}
